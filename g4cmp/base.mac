# SPDX-License-Identifier: GPL-3.0
# From G4CMP g4cmp-V10-05-00, examples/quasiparticle/G4Macros/quasiparticle_resonator_targeted.mac
# (https://github.com/kelseymh/G4CMP), GPL-3.0; see NOTICE and COPYING in this directory.
# Changed for radchain: visualisation commands removed, source at (0, 0, 4.81) mm, one event.
# l3_kernel_job.sh replaces /gps/energy, /gps/pos/centre, /gps/number and /run/beamOn per job.
# The shipped kernel record was made with this macro without these six header lines (sha256 919eb424...).
#-----------------------------------------------
# quasiparticle_resonator_targeted.mac
#
# This mimics a targeted single photon pulse in
# the top-left superconducting resonator in our
# geometry. We mimic the resonator pulse with a
# set of Debye-energy phonons that sum to our
# initial photon energy. For a 1.1 eV (red)
# photon, and Debye energy phonons of 36.9 meV
# (ref: Kozorezov et al, '99), we launch off
# 30 Debye energy phonons from this point.
#------------------------------------------

# Initialize the run
/run/initialize

# We'll use an OpenGL viewer here, and load
# a specific angle and zoom

/run/printProgress 1

# for drawing the tracks
/tracking/verbose 0
/tracking/storeTrajectory 1

# Trajectory coloring by particle type

# Trajectory filtering by particle type
#/vis/filtering/trajectories/particleFilter-0/add phononTS
#/vis/filtering/trajectories/particleFilter-0/add phononTF
#/vis/filtering/trajectories/particleFilter-0/add phononL

# Toggle phononBounces depending on whether
# you want to see a full event or not.
/g4cmp/phononBounces 1000000
/g4cmp/qpBounces 1000000000

#/process/inactivate phononScattering
#/process/inactivate phononDownconversion
/process/inactivate phononPolycrystalElasticScattering
#/process/inactivate qpRecombination
#/process/inactivate qpRadiatesPhonon
#/process/inactivate scPairBreaking
#/process/inactivate qpDiffusion 
#/process/inactivate qpLocalTrapping
#/process/inactivate qpDiffusionTimeStepper

# Generate 1 phonon per event. Place right under the Nb film
/gps/particle phononTF
/gps/pos/type Volume
/gps/pos/shape Para
#/gps/pos/centre -1.85 1.221 5.0001 mm # Point 2, in film

#These spawn phonons from a parallelepiped with the following
#half-dimensions (i.e. very small, 10nm box)
/gps/pos/halfx 0.00001 mm
/gps/pos/halfy 0.00001 mm
/gps/pos/halfz 0.00001 mm

/random/setSeeds 123456 567890

#Spawn 1 phonon per event with 36.9 meV, in random
#directions (isotropically)
/gps/ang/type iso
/gps/ene/type Mono
/gps/energy 0.0369 eV
/gps/pos/centre 0.0 0.0 4.81 mm
/gps/number 1
/run/beamOn 1
